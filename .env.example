# ============================================================
# FSLDK API — Contoh Konfigurasi Lingkungan
# Salin berkas ini menjadi `app.env` lalu sesuaikan nilainya.
# ============================================================

# --- Aplikasi ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200
TZ=Asia/Jakarta
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fsldk_db
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONN=50
DB_MAX_IDLE_CONN=10

# --- JWT ---
JWT_SECRET=ubah-dengan-secret-acak-yang-kuat
JWT_REFRESH_SECRET=ubah-dengan-refresh-secret-yang-berbeda
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=43200

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_DEFAULT_ROLE=Kontributor
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo

# --- Registrasi & Verifikasi ---
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=60
REGISTER_DEFAULT_ROLE=Pengunjung

# --- SMTP (WAJIB untuk verifikasi email & reset password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@fsldk-indonesia.com
MAIL_FROM_NAME=FSLDK Indonesia

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Comment System (GIF/sticker picker, get a free key at developers.giphy.com) ---
GIPHY_API_KEY=

# --- Kirimdev (api.kirimdev.com) — official Meta WhatsApp Business Cloud API
# passthrough, dipakai untuk notifikasi WhatsApp Shortlink Request (PIC & requester) ---
KIRIMDEV_API_KEY=
KIRIMDEV_PHONE_NUMBER_ID=
KIRIMDEV_BASE_URL=https://api.kirimdev.com/v1
KIRIMDEV_TEMPLATE_LANGUAGE=id
# Comma-separated, untuk rotasi tanpa downtime — simpan yang lama & baru sekaligus saat rotasi.
KIRIMDEV_WEBHOOK_SECRETS=
# Toleransi replay signature webhook inbound (menit).
KIRIMDEV_REPLY_WINDOW_MINUTES=5

# --- Job Queue (modules/jobqueue) — antrian pengiriman WhatsApp/email asinkron ---
JOBQUEUE_WORKER_COUNT=2
JOBQUEUE_POLL_INTERVAL_MS=1500
JOBQUEUE_STUCK_THRESHOLD_MINUTES=10
JOBQUEUE_DEFAULT_MAX_ATTEMPTS=5
JOBQUEUE_BACKOFF_SCHEDULE_SECONDS=15,30,60
JOBQUEUE_WHATSAPP_RATE_PER_MINUTE=8

# --- Kalkulator Zakat (Antam gold-price proxy, no API key) ---
ZAKAT_GOLD_PRICE_API_URL=https://logam-mulia-api.iamutaki.workers.dev/api/prices/logammulia
ZAKAT_GOLD_PRICE_FALLBACK=2600000
ZAKAT_GOLD_PRICE_CACHE_MINUTES=60
